  "type": "commonjs",
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^25.9.1"
  },
  "dependencies": {
    "dotenv": "^18.0.5",
    "envalid": "^8.2.0"
  }
}
